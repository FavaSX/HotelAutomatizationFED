# Copy these variables into the hosting server's environment (e.g. PythonAnywhere WSGI file).
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tuusuario.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com
# Secret admin path (must end with "/"), e.g. gestion-psf-8k2q/  -> keeps bots away from /admin/
DJANGO_ADMIN_URL=cambia-esta-ruta/
